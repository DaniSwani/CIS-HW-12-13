players = {}

# Read player information from file
file = open("players.txt", "r")

for line in file:
    data = line.strip().split(",")

    name = data[0]
    average = float(data[1])

    players[name] = average

file.close()

# Function to display players
def display_players():
    print("Player Name\tBatting Average")
    print("------------------------------")

    for name in players:
        print(name, "\t\t",
              format(players[name], ".3f"))

# Call function
display_players()
